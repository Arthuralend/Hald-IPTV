<Window x:Class="HaldIPTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="IPTV Pro Max" Width="1300" Height="780" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

        <!-- channel row (list mode) -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{Binding PlaceholderBrush}"
                        Visibility="{Binding PlaceholderVisibility}">
                    <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image Width="40" Height="40" Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" ★" Foreground="{StaticResource Orange}" Visibility="{Binding FavVisibility}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NowTitle}" Foreground="{StaticResource TextDim}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Visibility="{Binding EpgVisibility}"/>
                    <ProgressBar Value="{Binding Progress}" Maximum="1" Margin="0,2,0,0" Visibility="{Binding EpgVisibility}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="&#xE767;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Orange}"
                           VerticalAlignment="Center" Visibility="{Binding CurrentVisibility}"/>
            </Grid>
        </DataTemplate>

        <!-- channel tile (grid mode) -->
        <DataTemplate x:Key="TileTemplate">
            <Border Width="118" Height="128" Margin="4" CornerRadius="12" Background="{Binding TileBackground}"
                    BorderBrush="{Binding TileBorder}" BorderThickness="1.5">
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="72" Height="72">
                        <Border CornerRadius="12" Background="{Binding PlaceholderBrush}" Visibility="{Binding PlaceholderVisibility}">
                            <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                               MaxHeight="30" Margin="6,6,6,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ListPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel"><WrapPanel/></ItemsPanelTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSidebar" Width="232"/>
            <ColumnDefinition x:Name="ColList" Width="370" MinWidth="0"/>
            <ColumnDefinition x:Name="ColSplit" Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════ Sidebar ═════════ -->
        <DockPanel x:Name="SidebarPanel" Background="{StaticResource Sidebar}">
            <StackPanel DockPanel.Dock="Top" Margin="12,14,12,6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Image Source="Assets/logo.png" Width="34" Height="34"/>
                    <TextBlock Text="IPTV Pro Max" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="LblPlaylist" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,0,0,4"/>
                <ComboBox x:Name="PlaylistBox" DisplayMemberPath="Name" SelectionChanged="PlaylistBox_SelectionChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnAdd" Style="{StaticResource FlatButton}" Click="Add_Click" FontSize="13"/>
                    <Button x:Name="BtnEdit" Style="{StaticResource FlatButton}" Click="Edit_Click" FontFamily="{StaticResource Icons}" Content="&#xE70F;"/>
                    <Button x:Name="BtnRefresh" Style="{StaticResource FlatButton}" Click="Refresh_Click" FontFamily="{StaticResource Icons}" Content="&#xE72C;"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource FlatButton}" Click="Settings_Click" FontFamily="{StaticResource Icons}" Content="&#xE713;"/>
                </StackPanel>
                <ProgressBar x:Name="Loading" IsIndeterminate="True" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <ListBox x:Name="SidebarList" ItemContainerStyle="{StaticResource Item}" SelectionChanged="SidebarList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Orange}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="{Binding Weight}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{StaticResource TextDim}" Margin="6,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MiClearRecents" Click="ClearRecents_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <!-- ═════════ Channel list ═════════ -->
        <DockPanel x:Name="ListPanel" Grid.Column="1" Background="{StaticResource Panel}">
            <StackPanel DockPanel.Dock="Top" Margin="12,14,12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnClearRecents" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE74D;"
                                Click="ClearRecents_Click" Visibility="Collapsed"/>
                        <Button x:Name="BtnListMode" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE8FD;" Click="ListMode_Click"/>
                        <Button x:Name="BtnGridMode" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xF0E2;" Click="GridMode_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="SectionTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SectionCount" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
                <Grid Margin="0,10,0,0">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock x:Name="SearchHint" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                </Grid>
            </StackPanel>
            <Grid>
                <ListBox x:Name="ChannelList" ItemContainerStyle="{StaticResource Item}"
                         ItemTemplate="{StaticResource RowTemplate}" ItemsPanel="{StaticResource ListPanel}"
                         MouseLeftButtonUp="ChannelList_Click" KeyDown="ChannelList_KeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="ChannelMenu_Opened">
                            <MenuItem x:Name="MiFav" Click="Fav_Click"/>
                            <MenuItem x:Name="MiRemoveRecent" Click="RemoveRecent_Click"/>
                            <MenuItem x:Name="MiClearRecents2" Click="ClearRecents_Click"/>
                            <MenuItem x:Name="MiCopy" Click="Copy_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" FontSize="14" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>

        <GridSplitter x:Name="Splitter" Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="#59F2800A"/>

        <!-- ═════════ Player ═════════ -->
        <vlc:VideoView x:Name="Video" Grid.Column="3" Background="Black">
            <Grid x:Name="Overlay" Background="#01000000" MouseMove="Overlay_MouseMove"
                  MouseLeftButtonDown="Overlay_MouseDown">
                <!-- placeholder -->
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="150" Height="150" Opacity="0.9"/>
                    <TextBlock x:Name="PlaceholderText" FontSize="16" Foreground="{StaticResource TextDim}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#AA000000"
                        CornerRadius="14" Padding="14,6" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" Foreground="White"/>
                </Border>

                <!-- top: REC + toast -->
                <DockPanel VerticalAlignment="Top" Margin="14">
                    <Border x:Name="RecBadge" DockPanel.Dock="Left" Background="#AA000000" CornerRadius="12" Padding="10,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="Red" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RecText" Margin="6,0,0,0" FontFamily="Consolas" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ToastBox" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#CC000000"
                            CornerRadius="12" Padding="10,4" Visibility="Collapsed">
                        <TextBlock x:Name="ToastText" Foreground="White"/>
                    </Border>
                </DockPanel>

                <!-- bottom controls -->
                <Border x:Name="Controls" VerticalAlignment="Bottom" Padding="16,12" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#E0101010" Offset="0.45"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <!-- info -->
                        <DockPanel Margin="0,0,0,8">
                            <Grid Width="40" Height="40" DockPanel.Dock="Left" Margin="0,0,10,0">
                                <Border CornerRadius="8" Background="{Binding PlaceholderBrush}" Visibility="{Binding PlaceholderVisibility}">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding Logo}"/>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NowText" FontSize="12"/>
                                <ProgressBar x:Name="NowProgress" Maximum="1" Width="280" HorizontalAlignment="Left" Margin="0,3"/>
                                <TextBlock x:Name="NextText" FontSize="11" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- seek row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="BtnBack5" Style="{StaticResource FlatButton}" Content="« 5:00" FontSize="13" Click="Back5_Click"/>
                            <Button x:Name="BtnBack30" Style="{StaticResource FlatButton}" Content="« 30" FontSize="13" Click="Back30_Click"/>
                            <Button x:Name="BtnFwd30" Style="{StaticResource FlatButton}" Content="30 »" FontSize="13" Click="Fwd30_Click"/>
                            <Button x:Name="BtnFwd5" Style="{StaticResource FlatButton}" Content="5:00 »" FontSize="13" Click="Fwd5_Click"/>
                            <Button x:Name="BtnStartOver" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE892;" Click="StartOver_Click"/>
                            <Button x:Name="BtnLive" Style="{StaticResource FlatButton}" Click="Live_Click" Margin="6,0,0,0">
                                <Border CornerRadius="10" Background="#22FFFFFF" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource Orange}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LiveText" Margin="5,0,0,0" FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <TextBlock x:Name="PosText" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                        <!-- main row -->
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BtnPrev" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE892;" Click="Prev_Click"/>
                                <Button x:Name="BtnPlay" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE769;" Click="Play_Click"/>
                                <Button x:Name="BtnNext" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE893;" Click="Next_Click"/>
                                <Button x:Name="BtnFav" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE734;" Click="FavCurrent_Click"/>
                                <Button x:Name="BtnRec" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE7C8;" Click="Rec_Click"/>
                                <Button x:Name="BtnFolder" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE8B7;" Click="Folder_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnAudio" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE8D6;" Click="Audio_Click" Visibility="Collapsed"/>
                                <Button x:Name="BtnMute" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE767;" Click="Mute_Click"/>
                                <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="150" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                                <Button x:Name="BtnPin" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE718;" Click="Pin_Click"/>
                                <Button x:Name="BtnFull" Style="{StaticResource FlatButton}" FontFamily="{StaticResource Icons}" Content="&#xE740;" Click="Full_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
